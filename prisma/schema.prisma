generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  role         String          // "SUPER_ADMIN", "VIEWER"
  permissions  String          // JSON array of strings
  isAllowed    Boolean         @default(true)
  lastLogin    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  auditLogs    AuditLog[]
  versions     RecordVersion[]
}

model SourceFileArchive {
  id              String               @id @default(cuid())
  filename        String
  fileHash        String
  fileSizeBytes   Int
  uploadTimestamp DateTime             @default(now())
  filePath        String
  notes           String?
  cells           SourceWorkbookCell[]
}

model SourceWorkbookCell {
  id            Int               @id @default(autoincrement())
  archiveId     String
  archive       SourceFileArchive @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  worksheetName String
  cellAddress   String
  rowIndex      Int
  columnIndex   Int
  rawValue      String?
  formulaString String?
  isRefError    Boolean           @default(false)

  @@index([worksheetName, cellAddress])
  @@index([isRefError])
}

model FinancialPeriod {
  id               String                 @id @default(cuid())
  monthCode        String                 @unique // e.g. "2026-08", "2026-09"
  periodName       String                 // "August 2026", "September 2026"
  financialYear    String                 // "2026-27"
  startDate        String
  endDate          String
  status           String                 @default("Draft") // "Draft", "Approved", "Locked", etc.
  templateSourceId String?
  grossBilling     Float                  @default(0)
  totalDeductions  Float                  @default(0)
  netPayable       Float                  @default(0)
  totalPaid        Float                  @default(0)
  isDeleted        Boolean                @default(false)
  deletedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  monthlyRecords   VehicleMonthlyRecord[]
}

model Vehicle {
  id                 String                    @id @default(cuid())
  registrationNumber String                    // Can be "KA-UNSPECIFIED-SEC46"
  carName            String?                   // e.g. "Innova Crysta #1"
  make               String?                   // e.g. "Toyota", "Maruti Suzuki"
  model              String?                   // e.g. "Innova Crysta", "Dzire"
  category           String?                   @default("SEDAN") // "SEDAN", "SUV", "HATCHBACK", "TEMPO", "BUS"
  vehicleType        String                    @default("Vehicle - 4-Seater")
  seatingCapacity    Int?                      @default(4)
  fuelType           String?                   // "DIESEL", "PETROL", "CNG", "ELECTRIC", "HYBRID"
  status             String                    @default("ACTIVE") // "ACTIVE", "INACTIVE", "UNDER_MAINTENANCE", "RETIRED"
  isActive           Boolean                   @default(true)
  ownerName          String?
  contactNumber      String?
  bankAccountMasked  String?
  bankName           String?
  ifscCode           String?
  notes              String?
  remarks            String?
  isDeleted          Boolean                   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  monthlyRecords     VehicleMonthlyRecord[]
  assignments        VehicleDriverAssignment[]

  @@index([status])
  @@index([isDeleted])
}

model Driver {
  id            String                    @id @default(cuid())
  name          String
  panEncrypted  String?
  panMasked     String?
  dlEncrypted   String?
  dlMasked      String?
  licenceExpiry DateTime?
  phone         String?
  status        String                    @default("ACTIVE") // "ACTIVE", "INACTIVE", "ON_LEAVE", "TERMINATED"
  remarks       String?
  isDeleted     Boolean                   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  assignments   VehicleDriverAssignment[]

  @@index([status])
  @@index([licenceExpiry])
  @@index([isDeleted])
}

model VehicleDriverAssignment {
  id         String    @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId   String
  driver     Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  startDate  DateTime  @default(now())
  endDate    DateTime?
  isCurrent  Boolean   @default(true)
  assignedBy String?   // email of user who assigned
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([vehicleId])
  @@index([driverId])
  @@index([isCurrent])
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?
  category    String?
  defaultRate Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VehicleMonthlyRecord {
  id             String                @id @default(cuid())
  periodId       String
  period         FinancialPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  sectionIndex   Int                   // 1 to 46
  calcHeader     String?
  periodLabel    String?
  grossBilling   Float                 @default(0)
  totalDeductions Float                @default(0)
  netPayable     Float                 @default(0)
  amountPaid     Float                 @default(0)
  paymentStatus  String                @default("Draft") // "Paid", "Partially Paid", "HOLD", "WF", "No Account", "Draft"
  paymentDate    String?
  bankDetails    String?
  bankRemarks    String?
  hasRefErrors   Boolean               @default(false)
  refErrorCount  Int                   @default(0)
  remarks        String?
  isDeleted      Boolean               @default(false)
  deletedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  billingLines   BillingLine[]
  adjustments    FinancialAdjustment[]
  payments       PaymentTransaction[]
  versions       RecordVersion[]

  @@index([periodId, sectionIndex])
  @@index([vehicleId])
}

model BillingLine {
  id             String               @id @default(cuid())
  recordId       String
  record         VehicleMonthlyRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  sourceRow      Int?
  companyName    String
  kmOrTrips      Float?
  kmFormula      String?
  applicableRate Float?
  rateFormula    String?
  billingAmount  Float                @default(0)
  amountFormula  String?
  lineOrder      Int                  @default(0)
  isDeleted      Boolean              @default(false)

  @@index([recordId])
}

model FinancialAdjustment {
  id               String               @id @default(cuid())
  recordId         String
  record           VehicleMonthlyRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  sourceRow        Int?
  category         String
  adjustmentType   String               @default("DEDUCTION") // "DEDUCTION" or "ADDITION"
  amount           Float                @default(0)
  formulaString    String?
  isPostSettlement Boolean              @default(false)
  meta1            String?
  meta2            String?
  notes            String?
  isDeleted        Boolean              @default(false)

  @@index([recordId])
}

model PaymentTransaction {
  id              String               @id @default(cuid())
  recordId        String
  record          VehicleMonthlyRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  amount          Float
  paymentDate     String
  paymentMode     String               @default("BANK_TRANSFER")
  referenceNumber String?
  bankName        String?
  remarks         String?
  recordedBy      String?
  createdAt       DateTime             @default(now())
  isDeleted       Boolean              @default(false)

  @@index([recordId])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail     String
  action        String   // "CREATE", "UPDATE", "DELETE", "RESTORE", "REVERT", "APPROVE", "CLONE_MONTH", "IMPORT", "EXPORT", "LOGIN", "LOGOUT"
  module        String   // "MONTHLY_FINANCE", "VEHICLES", "BILLING", "ADJUSTMENTS", "PAYMENTS", "USERS", "IMPORT"
  entityType    String
  entityId      String?
  previousState String?  // JSON string
  newState      String?  // JSON string
  reason        String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([module, action])
  @@index([createdAt])
}

model RecordVersion {
  id            String               @id @default(cuid())
  recordId      String
  record        VehicleMonthlyRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  versionNumber Int
  snapshotData  String               // JSON string
  changeReason  String?
  createdById   String?
  createdBy     User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())

  @@index([recordId, versionNumber])
}

model RecycleBinItem {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String
  displayName    String
  deletedByEmail String
  deletedAt      DateTime @default(now())
  snapshotData   String
  restoreStatus  String   @default("DELETED") // "DELETED", "RESTORED", "PURGED"

  @@index([restoreStatus])
}



model BankAccount {
  id           String              @id @default(cuid())
  accountName  String              @unique // "Bank Balance", "DCO", "Profit Sharing", etc.
  accountSlug  String              @unique // "bank-balance", "dco", "profit-sharing", etc.
  accountType  String              @default("SUPPORTING") // "MAIN" or "SUPPORTING"
  description  String?
  displayOrder Int                 @default(0)
  isDeleted    Boolean             @default(false)
  deletedAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  entries      BankAccountEntry[]
  periods      BankAccountPeriod[]

  @@index([accountSlug])
  @@index([accountType])
}

model BankAccountPeriod {
  id             String      @id @default(cuid())
  accountId      String
  account        BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  periodCode     String      // "2024-25", "2025-26", "2026-27", "ALL", etc.
  periodLabel    String      // "FY 2025-26", "Consolidated 2025-2026", etc.
  openingBalance Float       @default(0)
  totalIncome    Float       @default(0)
  totalExpense   Float       @default(0)
  netBalance     Float       @default(0)
  closingBalance Float       @default(0)
  status         String      @default("ACTIVE") // "ACTIVE", "LOCKED", "RECONCILED"
  isLocked       Boolean     @default(false)
  remarks        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([accountId, periodCode])
  @@index([accountId])
}

model BankAccountEntry {
  id              String      @id @default(cuid())
  accountId       String
  account         BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  periodCode      String?     // e.g. "2025-01", "2026-MAY", "2025-26"
  entryDate       String?     // Date string or period label
  section         String?     // "PAYMENT", "EXPENSE", "PROFIT", "MARGIN", "INVESTMENT", "DEDUCTION", etc.
  category        String?     // Subcategory (e.g. "RENT", "Current Bill", "Fuel Commission")
  particulars     String?     // Description / Item name
  sourceReference String?     // Reference / Vendor / Site
  amount          Float       @default(0)
  rawAmount       String?     // Original string representation
  formulaString   String?     // Original Excel formula if any
  paidAmount      Float?
  receivedAmount  Float?
  netAmount       Float?
  invoicedAmount  Float?
  invoiceDate     String?
  invoiceNo       String?
  comments        String?
  remarks         String?
  meta            String?     // JSON metadata for sheet-specific extra columns/fields
  rowIndex        Int?
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([accountId])
  @@index([section])
  @@index([isDeleted])
}


model TdsRecord {
  id                 String       @id @default(cuid())
  financialYear      String       // "2025-26", "2026-27", etc.
  financialMonth     String       // "Aug-26", "Sep-26", "Nov-26", etc.
  companyName        String       // "ECO Travels", "ORIX", "ANP-HCL", etc.
  tdsCategory        String       // "194C - Cab Transport", "194J", etc.
  amount             Float
  transactionDate    String       // "YYYY-MM-DD"
  tdsReferenceNo     String?      // Challan No / 26AS reference
  invoiceReference   String?      // Invoice number or trip reference
  accountingType     String       @default("RECEIVABLE") // "RECEIVABLE", "PAID_GOVERNMENT", "WITHHELD", "ADJUSTMENT"
  status             String       @default("CONFIRMED")  // "CONFIRMED", "PENDING", "RECONCILED"
  remarks            String?
  isDeleted          Boolean      @default(false)
  deletedAt          DateTime?
  createdById        String?
  createdByEmail     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  versions           TdsVersion[]

  @@index([financialYear, financialMonth])
  @@index([companyName])
  @@index([accountingType])
  @@index([isDeleted])
}

model TdsVersion {
  id             String    @id @default(cuid())
  tdsRecordId    String
  tdsRecord      TdsRecord @relation(fields: [tdsRecordId], references: [id], onDelete: Cascade)
  versionNumber  Int
  snapshotData   String    // JSON snapshot for instant version revert
  changeReason   String?
  createdById    String?
  createdByEmail String?
  createdAt      DateTime  @default(now())

  @@index([tdsRecordId, versionNumber])
}


model FuelCommissionRecord {
  id                   String                  @id @default(cuid())
  financialYear        String                  // e.g. "2026-27"
  financialMonth       String                  // e.g. "Jan-26", "Feb-26", "Other"
  commissionDate       String                  // "YYYY-MM-DD"
  siteName             String                  // e.g. "Hari", "AMZ", "ECO", "WF", "Oracle", "6188", etc.
  vehicleNumber        String?                 // e.g. "KA41D 6188"
  category             String                  // "MONTHLY", "OPENING", "ADJUSTMENT"
  amount               Float                   // Positive for earnings, negative for adjustments
  accountingType       String                  @default("EARNED") // "EARNED", "RECEIVED", "ADJUSTMENT"
  status               String                  @default("PENDING") // "EARNED", "RECEIVED", "PARTIALLY_RECEIVED"
  receivedAmount       Float                   @default(0)
  pendingAmount        Float                   @default(0)
  description          String?
  transactionReference String?
  bankReference        String?                 // Link to bank deposit transaction if deposited
  remarks              String?
  isDeleted            Boolean                 @default(false)
  deletedAt            DateTime?
  createdById          String?
  createdByEmail       String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  versions             FuelCommissionVersion[]

  @@index([financialYear, financialMonth])
  @@index([siteName])
  @@index([category])
  @@index([accountingType])
  @@index([isDeleted])
}

model FuelCommissionVersion {
  id              String               @id @default(cuid())
  recordId        String
  record          FuelCommissionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  versionNumber   Int
  snapshotData    String               // JSON snapshot for full version revert
  changeReason    String?
  createdById     String?
  createdByEmail  String?
  createdAt       DateTime             @default(now())

  @@index([recordId, versionNumber])
}


model AccountingCategory {
  id                    String                 @id @default(cuid())
  name                  String                 @unique // e.g. "Vehicle Repair", "Driver Penalty", "Insurance", "New Car EMI"
  description           String?
  assignedAccountSlug   String                 @default("ALL") // "ALL", "sst", "expense", "harish-gs", etc.
  transactionType       String                 // "EXPENSE", "INCOME", "DEDUCTION", "ADDITION", "ADJUSTMENT", "TRANSFER"
  defaultClassification String                 @default("DEBIT") // "DEBIT" or "CREDIT"
  isCashImpact          Boolean                @default(true) // Whether payment impacts bank cash
  requiresConfirmation  Boolean                @default(true) // Requires status "PAID" or "RECEIVED"
  reportingGroup        String?                // "OPERATING", "VEHICLE", "DRIVER", "TAX", "ADMIN"
  isActive              Boolean                @default(true)
  createdById           String?
  createdByEmail        String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  ledgerEntries         FinancialLedgerEntry[]

  @@index([assignedAccountSlug])
  @@index([transactionType])
  @@index([isActive])
}

model FinancialLedgerEntry {
  id                   String              @id @default(cuid())
  transactionId        String              @unique // Unique sequential ID, e.g. "TXN-202611-001"
  transactionDate      String              // "YYYY-MM-DD"
  financialMonth       String              // "Nov-26", "Dec-26", etc.
  financialYear        String              // "2026-27"
  sourceModule         String              // "SUPPORTING_ACCOUNT", "TDS", "FUEL_COMMISSION", "DIRECT_BANK"
  sourceAccountSlug    String?             // "sst", "expense", "bank-balance", etc.
  sourceRecordId       String?             // Foreign ID in BankAccountEntry / TdsRecord / FuelCommissionRecord
  categoryId           String?
  category             AccountingCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryName         String              // Fallback category name
  companyOrParty       String?             // Client or vendor name
  description          String
  debitAmount          Float               @default(0) // Dr amount
  creditAmount         Float               @default(0) // Cr amount
  netAmount            Float               @default(0) // Net balance movement
  transactionType      String              // "EXPENSE", "RECEIPT", "PAYMENT", "ADJUSTMENT", "TRANSFER"
  paymentStatus        String              @default("PAID") // "PAID", "RECEIVED", "PENDING", "NON_CASH"
  paymentMode          String?             // "BANK_TRANSFER", "NEFT", "RTGS", "CHEQUE", "CASH", "INTERNAL"
  bankAccountRef       String?             @default("Bank Balance (Main)")
  bankTxnReference     String?             // UTR, Cheque number, deposit slip reference
  isPostedToBank       Boolean             @default(true)
  postedAt             DateTime?           @default(now())
  isReconciled         Boolean             @default(false)
  reconciledAt         DateTime?
  isReversed           Boolean             @default(false)
  reversalReason       String?
  reversedAt           DateTime?
  remarks              String?
  createdById          String?
  createdByEmail       String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([financialYear, financialMonth])
  @@index([sourceAccountSlug])
  @@index([paymentStatus])
  @@index([isPostedToBank])
}
