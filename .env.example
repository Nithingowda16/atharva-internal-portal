# ==============================================================================
# ATHARVA TRAVELS - Production Environment Configuration (.env.example)
#
# Configure these variables in the Netlify Dashboard:
# Site configuration > Environment variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY DATABASE (Hosted PostgreSQL - Supabase, Neon, AWS RDS)
# ------------------------------------------------------------------------------
# Connection Pool URL (Recommended for Serverless/Netlify Functions)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"

# Direct Database URL (Required by Prisma for zero-downtime migrations)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# ------------------------------------------------------------------------------
# 2. SESSION AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# 32+ character random secret for signing and verifying JWT session cookies
JWT_SECRET="generate-a-secure-random-64-character-string-for-production"

# Canonical production portal URL
NEXTAUTH_URL="https://atharva-finance.netlify.app"

# Node environment flag
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 3. DURABLE PRIVATE OBJECT STORAGE (AWS S3, Cloudflare R2, Supabase Storage)
# ------------------------------------------------------------------------------
# Private bucket for archived Excel source workbooks & exported audit statements
S3_BUCKET="atharva-travels-private-storage"

# S3 Region (e.g., "ap-south-1" for AWS Mumbai, or "auto" for Cloudflare R2)
S3_REGION="ap-south-1"

# S3 Compatible API Credentials
S3_ACCESS_KEY_ID="your_s3_or_r2_access_key_id"
S3_SECRET_ACCESS_KEY="your_s3_or_r2_secret_access_key"

# Custom Endpoint (Required for Cloudflare R2, Supabase S3, MinIO. Leave empty for AWS S3)
# Example Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# Example Supabase S3:   https://<project_ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=""

# ------------------------------------------------------------------------------
# 4. CI/CD BUILD & DEPLOYMENT FLAGS
# ------------------------------------------------------------------------------
# Automatically run 'prisma migrate deploy' during Netlify build
PRISMA_MIGRATE="true"

